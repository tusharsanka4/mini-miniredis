{
  "openapi": "3.0.3",
  "info": {
    "title": "mini-miniredis HTTP API",
    "version": "0.1.0",
    "description": "A local JSON interface to the same store used by the Redis TCP listener. Command arguments are strings. Command results are returned as JSON strings, integers, arrays of strings, or null. This API is intended for UTF-8 text; use the TCP interface for arbitrary binary data. No authentication is required."
  },
  "servers": [{ "url": "http://127.0.0.1:8080" }],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Check that the HTTP server is running",
        "responses": {
          "200": {
            "description": "HTTP server is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": { "status": { "type": "string", "enum": ["ok"] } }
                },
                "example": { "status": "ok" }
              }
            }
          },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      }
    },
    "/command": {
      "post": {
        "operationId": "executeCommand",
        "summary": "Execute one supported Redis command",
        "description": "Shares data with TCP clients. All arguments, including scores and indexes, must be strings. The body must contain exactly one JSON object, with no unknown fields, and may be at most 2 MiB. Up to 1024 command elements are accepted, each at most 1 MiB in UTF-8. Missing values return a successful null result. Commands can mutate data, so blindly retrying a write may repeat it. See README.md for the supported command forms.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["command"],
                "properties": {
                  "command": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1024,
                    "items": { "type": "string" }
                  }
                }
              },
              "examples": {
                "set": { "value": { "command": ["SET", "name", "tushar"] } },
                "get": { "value": { "command": ["GET", "name"] } },
                "list": { "value": { "command": ["LRANGE", "tasks", "0", "-1"] } },
                "sortedSet": { "value": { "command": ["ZRANGE", "scores", "0", "-1", "WITHSCORES"] } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Command succeeded. Scores remain strings; collection replies are flat arrays, including HGETALL and ZRANGE WITHSCORES. Non-UTF-8 stored strings are represented using JSON replacement characters.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["result"],
                  "properties": {
                    "result": {
                      "oneOf": [
                        { "type": "string", "nullable": true },
                        { "type": "integer", "format": "int64" },
                        { "type": "array", "items": { "type": "string" } }
                      ]
                    }
                  }
                },
                "examples": {
                  "ok": { "value": { "result": "OK" } },
                  "missing": { "value": { "result": null } },
                  "count": { "value": { "result": 2 } },
                  "list": { "value": { "result": ["first", "second"] } }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "413": { "description": "Request body exceeds 2 MiB", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "415": { "description": "Content-Type must be application/json", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "500": { "description": "Unexpected internal reply format", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      }
    },
    "responses": {
      "MethodNotAllowed": {
        "description": "HTTP method is not supported for this endpoint",
        "headers": { "Allow": { "description": "Supported method: GET for /health, POST for /command", "schema": { "type": "string" } } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "BadRequest": {
        "description": "Malformed request, invalid arguments, unknown command, or wrong key type. The command is not retried.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "examples": {
              "unknownCommand": { "value": { "error": "ERR unknown command" } },
              "wrongType": { "value": { "error": "WRONGTYPE Operation against a key holding the wrong kind of value" } }
            }
          }
        }
      }
    }
  }
}
